---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada — AENDRA" description="Esta página no existe, pero tu casa ideal sí." path="/404">
  <section class="cabeza cierre" style="min-height:70vh;display:grid;place-items:center">
    <div class="contenedor">
      <p class="label">404</p>
      <p class="frase" style="margin:1rem auto">Esta página se fue a <em>redecorar</em></p>
      <div class="acciones"><a href="/" class="btn btn--solido">Volver al inicio</a><a href="/tienda" class="btn btn--linea">Ir a la tienda</a></div>
    </div>
  </section>
</Base>
