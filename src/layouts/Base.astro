---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/overlays.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Overlays from '../components/Overlays.astro';

interface Props {
  title: string;
  description: string;
  path: string;                 // ruta canónica, ej. "/tienda"
  ogImage?: string;             // ruta del sitio, ej. "/img/ambientes/sala.webp"
  schema?: object | object[];   // JSON-LD extra de la página
  sobreFoto?: boolean;          // nav transparente sobre una foto a pantalla completa
}
const { title, description, path, ogImage = '/assets/images/og-image.svg', schema, sobreFoto = false } = Astro.props;
const sitio = 'https://www.aendra.lat';
const canonical = sitio + (path === '/' ? '/' : path);
const og = ogImage.startsWith('http') ? ogImage : sitio + ogImage;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AENDRA">
  <meta property="og:locale" content="es_PE">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={og}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#F5EFE6">
  <meta name="geo.region" content="PE-LIM">
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  {schemas.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>document.documentElement.classList.add('js-motion');</script>
</head>
<body>
  <Nav sobreFoto={sobreFoto} actual={path} />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
  <Overlays />

  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.47.2/dist/umd/supabase.min.js" integrity="sha384-m2m34D9XY1LA/zjjscXeJ1CKlZ3o7vDfmdDdPVACmRgHv9sQEDFYH5A/RQ9oYjkw" crossorigin="anonymous"></script>
  <script is:inline src="/js/supabase-client.js"></script>
  <script is:inline src="/js/site.js"></script>
  <script is:inline src="/js/cart.js"></script>
  <script is:inline src="/js/auth.js"></script>
  <script is:inline src="/js/checkout.js"></script>
  <script is:inline src="/js/moodboard.js"></script>
  <script is:inline src="/js/motion.js"></script>
  <script is:inline>
    // Cada módulo arranca por separado: un error en uno no debe apagar a los demás (lección de Waitlist.init)
    // (Auth/Cart/Checkout son `const` globales, no propiedades de window)
    [['Auth', () => Auth.init()], ['Cart', () => Cart.init()], ['Checkout', () => Checkout.init()]].forEach(([n, iniciar]) => {
      try { iniciar(); } catch (e) { console.error(n + '.init falló', e); }
    });
  </script>
  <slot name="scripts" />
</body>
</html>
