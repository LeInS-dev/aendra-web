---
// Markup de carrito, login, checkout, toast y WhatsApp flotante: copiado del sitio anterior.
// Los IDs los usan public/js/{cart,auth,checkout}.js; no renombrarlos.
---
<div class="toast" id="toast"></div>
<div class="auth-overlay" id="auth-overlay"></div>
<div class="auth-modal" id="auth-modal">
    <button class="auth-modal-close" onclick="Auth.close()">✕</button>
    <h2>AENDRA</h2>
    <p class="auth-sub">Tu cuenta para gestionar pedidos</p>
    <div class="auth-tabs">
        <button class="auth-tab active" data-tab="login">Ingresar</button>
        <button class="auth-tab" data-tab="register">Crear cuenta</button>
    </div>
    <form class="auth-form active" id="form-login">
        <div class="field"><label>Email</label><input type="email" name="email" placeholder="tu@email.com" required></div>
        <div class="field"><label>Contraseña</label><input type="password" name="password" placeholder="••••••••" required></div>
        <p class="auth-error"></p>
        <button type="submit" data-label="Ingresar">Ingresar</button>
    </form>
    <form class="auth-form" id="form-register">
        <div class="field"><label>Nombre completo</label><input type="text" name="fullname" placeholder="Tu nombre" required></div>
        <div class="field"><label>Email</label><input type="email" name="email" placeholder="tu@email.com" required></div>
        <div class="field"><label>Contraseña</label><input type="password" name="password" placeholder="Mín. 8 caracteres" required></div>
        <div class="field"><label>Celular (opcional)</label><input type="tel" name="phone" placeholder="+51 9XX XXX XXX"></div>
        <p class="auth-error"></p>
        <button type="submit" data-label="Crear cuenta">Crear cuenta</button>
    </form>
</div>

<!-- Cart Sidebar -->
<div class="cart-overlay" id="cart-overlay"></div>
<div class="cart-sidebar" id="cart-sidebar">
    <div class="cart-header"><h3>Tu Carrito</h3><button id="cart-close-btn">✕</button></div>
    <div id="cart-items-list"></div>
    <div id="cart-empty">Tu carrito esta vacio</div>
    <div class="cart-footer">
        <div class="cart-total"><span>Total</span><span id="cart-total-amount">S/0.00</span></div>
        <div id="cart-actions"><button id="cart-checkout-btn">Proceder al pago</button></div>
    </div>
</div>

<!-- Checkout Modal -->
<div class="checkout-overlay" id="checkout-overlay"></div>
<div class="checkout-modal" id="checkout-modal">
    <button class="checkout-close" id="checkout-close-btn">✕</button>
    <div class="checkout-steps">
        <div class="checkout-step active" data-step="1">
            <span class="step-num">1</span><span class="step-label">Envio</span>
        </div>
        <div class="checkout-step" data-step="2">
            <span class="step-num">2</span><span class="step-label">Pago</span>
        </div>
        <div class="checkout-step" data-step="3">
            <span class="step-num">3</span><span class="step-label">Confirmación</span>
        </div>
    </div>

    <!-- Step 1: Shipping -->
    <div class="checkout-panel active" id="step-shipping">
        <h3>Información de envío</h3>
        <form id="shipping-form">
            <div class="field">
                <label for="shipping-name">Nombre completo</label>
                <input type="text" id="shipping-name" required placeholder="Tu nombre completo">
            </div>
            <div class="field">
                <label for="shipping-phone">Celular</label>
                <input type="tel" id="shipping-phone" required placeholder="+51 9XX XXX XXX">
            </div>
            <div class="field">
                <label for="shipping-address">Dirección</label>
                <input type="text" id="shipping-address" required placeholder="Calle, número, referencia">
            </div>
            <div class="field-row">
                <div class="field">
                    <label for="shipping-city">Ciudad</label>
                    <input type="text" id="shipping-city" required placeholder="Lima">
                </div>
                <div class="field">
                    <label for="shipping-district">Distrito</label>
                    <input type="text" id="shipping-district" required placeholder="Miraflores">
                </div>
            </div>
            <button type="submit" id="btn-to-payment">Continuar al pago</button>
        </form>
    </div>

    <!-- Step 2: Payment -->
    <div class="checkout-panel" id="step-payment">
        <h3>Método de pago</h3>
        <form id="payment-form">
            <div id="payment-form-fields">
                <div class="field">
                    <label for="card-number">Número de tarjeta</label>
                    <input type="text" id="card-number" placeholder="4111 1111 1111 1111" maxlength="19">
                </div>
                <div class="field-row">
                    <div class="field">
                        <label for="card-expiry">Vencimiento</label>
                        <input type="text" id="card-expiry" placeholder="MM/AA" maxlength="5">
                    </div>
                    <div class="field">
                        <label for="card-cvv">CVV</label>
                        <input type="text" id="card-cvv" placeholder="123" maxlength="4">
                    </div>
                </div>
            </div>
            <p id="payment-error" class="auth-error"></p>
            <div id="payment-processing" style="display:none;text-align:center;padding:20px;">
                <p>Procesando pago...</p>
            </div>
            <div style="display:flex;gap:10px;">
                <button type="button" id="btn-back-shipping" style="flex:1;background:transparent;border:1px solid var(--border);color:var(--text-secondary);">Volver</button>
                <button type="submit" id="btn-confirm-payment" style="flex:2;">Confirmar Pago</button>
            </div>
        </form>
    </div>

    <!-- Step 3: Confirmation -->
    <div class="checkout-panel" id="step-confirmation">
        <div style="text-align:center;padding:30px 0;">
            <div style="font-size:3rem;margin-bottom:15px;">✓</div>
            <h3>Pedido Confirmado</h3>
            <p style="margin:10px 0;">Tu pedido <strong id="confirm-order-id"></strong> ha sido registrado.</p>
            <p style="margin:10px 0;">Total: <strong id="confirm-total"></strong></p>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:1.2rem 0;">Te contactaremos por WhatsApp para coordinar el envio y confirmar los detalles.</p>
            <button id="btn-checkout-done" style="margin-top:20px;">Volver a la tienda</button>
        </div>
    </div>
</div>

